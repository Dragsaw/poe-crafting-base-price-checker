# The whole User-Agent header, verbatim (NFR-9, AD-8). `sync` composes nothing:
# the tool name has one spelling and the contact address lives outside the repo.
# Unset or blank, the trade client refuses before it issues anything.
POE_SYNC_USER_AGENT=poe-crafting-base-price-checker/0.0.0 (+https://github.com/<you>/poe-crafting-base-price-checker; contact: you@example.com)

# Optional. Your pathofexile.com POESESSID session cookie, read only by
# `pnpm sync` and `pnpm sync:batch`. Leave it empty to sync unauthenticated.
# This value gives near-full access to your account: never commit it.
# Signing out of pathofexile.com revokes it.
POESESSID=