{
  "name": "poe-crafting-base-price-checker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "prepare": "node tools/setup-git-hooks.mjs",
    "typecheck": "tsc -b && node tools/dts-specifiers/rewrite-dts-specifiers.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:prune": "eslint . --prune-suppressions",
    "dup": "jscpd",
    "knip": "knip",
    "depcruise": "depcruise packages --config .dependency-cruiser.mjs",
    "check": "node tools/check/check.ts",
    "check:fast": "node tools/check/check.ts --fast",
    "test": "vitest run --project=!data",
    "test:data": "vitest run --project data",
    "dev": "vite --config packages/web/vite.config.ts",
    "dev:stop": "node tools/dev-stop/development-stop.ts",
    "deferred:issues": "node tools/deferred-issues/deferred-issues.ts",
    "build": "vite build --config packages/web/vite.config.ts && node tools/prune-pages.mjs",
    "sync": "node --env-file-if-exists=.env packages/sync/src/sync.ts",
    "sync:batch": "node --env-file-if-exists=.env packages/sync/src/sync-batch.ts",
    "sync:dry": "node packages/sync/src/dry-run.ts",
    "fixtures:record": "node --env-file-if-exists=.env packages/sync/src/fixtures-record.ts",
    "catalogue:refresh": "node --env-file-if-exists=.env packages/sync/src/catalogue-refresh.ts",
    "tracked:lookup": "node .claude/skills/tracked-json/scripts/lookup.ts",
    "tracked:check": "node packages/sync/src/curation/check.ts"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@poe/contracts": "workspace:*",
    "@poe/core": "workspace:*",
    "@types/node": "24.10.1",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "77.0.0",
    "jscpd": "5.4.0",
    "jsdom": "30.1.0",
    "knip": "6.39.0",
    "msw": "2.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
